# Welfare Pride HPP Reporting Portal — Docker environment variables
# Copy to .env and fill in real values before running: docker compose up -d

NODE_ENV=production
APP_ORIGIN=https://beacon.welfarepride.org
APP_SESSION_SECRET=REPLACE_ME_with_at_least_32_characters_random
APP_ENCRYPTION_KEY=REPLACE_ME_base64_encoded_32_bytes==
