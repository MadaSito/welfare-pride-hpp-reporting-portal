# Example only. Inject real values through the hosting environment or a secret manager.
# Do not commit secrets. Do not deploy this application with real data until the
# production-security assessment has been addressed.
NODE_ENV=production
PORT=3000
APP_ORIGIN=https://reporting.example.org

# Provide a unique high-entropy secret; never use a published example value.
APP_SESSION_SECRET=
# Base64 encoding of 32 independently generated random bytes, stored separately.
APP_ENCRYPTION_KEY=

# This directory must be private, persistent, backed up and outside web/deployment roots.
# Confirm the selected Hostinger plan supports an appropriate location.
DATA_DIR=/absolute/path/to/private/persistent/portal-data
