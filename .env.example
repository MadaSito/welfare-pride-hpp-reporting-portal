# Welfare Pride HPP Reporting Portal — environment configuration
# Copy to .env and fill in production secrets before starting the server.

NODE_ENV=production
PORT=3000

# Public origin of the portal (required in production for CSRF + cookie scoping)
APP_ORIGIN=https://reporting.welfarepride.org

# Session signing secret (32+ random characters)
APP_SESSION_SECRET=change-me-to-a-very-long-random-secret-at-least-32-chars

# AES-256-GCM encryption key for secrets at rest (32 bytes, base64)
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Directory for the SQLite database and backup snapshots.
# On Hostinger, keep this OUTSIDE the web root so it survives redeployments.
DATA_DIR=/home/u123456789/portal-data

# Set true behind Hostinger passenger or Cloudflare (trusts X-Forwarded-*)
# TRUST_PROXY=true

# Immutable mandatory BCC for all outbound emails (compliance override)
# GLOBAL_EMAIL_BCC=compliance@welfarepride.org

# Seeded admin credentials on first run (optional)
# BOOTSTRAP_ADMIN_EMAIL=admin@welfarepride.org
# BOOTSTRAP_ADMIN_PASSWORD=your-secure-password
